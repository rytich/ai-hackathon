{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.microdotz.net/schemas/metrics/work-unit.schema.json",
  "title": "Agentic Framework Work Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_unit_id",
    "project_id",
    "kind",
    "purpose",
    "consumption_reason",
    "profile",
    "model",
    "tokens",
    "token_source",
    "elapsed_ms",
    "outcome",
    "retry_count",
    "review_findings_count",
    "rework_count",
    "quality_gate",
    "links",
    "artifact_refs",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "work_unit_id": { "type": "string", "format": "uuid" },
    "project_id": { "$ref": "#/$defs/slug" },
    "kind": { "enum": ["research", "specification", "implementation", "test", "review", "coordination"] },
    "purpose": { "enum": ["feature", "bugfix", "maintenance", "documentation", "release", "adoption", "other"] },
    "consumption_reason": { "enum": ["primary", "retry", "review_fix", "tool_failure", "scope_change"] },
    "profile": { "$ref": "#/$defs/slug" },
    "model": { "$ref": "#/$defs/slug" },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "total"],
      "properties": {
        "input": { "$ref": "#/$defs/nullableCount" },
        "output": { "$ref": "#/$defs/nullableCount" },
        "total": { "$ref": "#/$defs/nullableCount" }
      }
    },
    "token_source": { "enum": ["manual", "agent_reported", "unavailable"] },
    "elapsed_ms": { "$ref": "#/$defs/nullableCount" },
    "outcome": { "enum": ["completed", "partial", "failed", "cancelled"] },
    "retry_count": { "$ref": "#/$defs/count" },
    "review_findings_count": { "$ref": "#/$defs/nullableCount" },
    "rework_count": { "$ref": "#/$defs/count" },
    "quality_gate": { "enum": ["pass", "fail", "unknown", "not_applicable"] },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": { "$ref": "#/$defs/slug" },
        "issue_number": { "type": "integer", "minimum": 1 },
        "pr_number": { "type": "integer", "minimum": 1 },
        "release": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$" }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/pathRef" },
          { "$ref": "#/$defs/issueRef" },
          { "$ref": "#/$defs/prRef" }
        ]
      }
    },
    "collector_id": { "$ref": "#/$defs/slug" },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "count": { "type": "integer", "minimum": 0 },
    "nullableCount": { "type": ["integer", "null"], "minimum": 0 },
    "pathRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "path" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "issueRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "number"],
      "properties": {
        "type": { "const": "issue" },
        "number": { "type": "integer", "minimum": 1 }
      }
    },
    "prRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "number"],
      "properties": {
        "type": { "const": "pr" },
        "number": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
